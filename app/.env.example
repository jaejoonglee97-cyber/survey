# ── 공개 값(브라우저에 노출되어도 됨) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 데이터 저장 방식: google(구글 시트) 또는 local(시트 없이 이 PC의 .local-data/sheets.json 에 더미 데이터로 개발)
DATA_BACKEND=local

# ── 아래는 서버 전용. NEXT_PUBLIC_ 접두사 금지, 저장소 커밋 금지 ──
# 데이터 스프레드시트 ID (URL의 /d/<여기>/edit 부분). 개발·Preview는 더미 시트, Production만 운영 시트
GOOGLE_SHEETS_ID=
# 이 값이 production 일 때만 운영 시트로 취급함. 개발은 dummy
SHEETS_ENV=dummy
# 서비스 계정 이메일(...@...iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 서비스 계정 비공개 키. JSON 키 파일의 private_key 값을 한 줄로(줄바꿈은 \n 그대로) 큰따옴표 안에 넣음
GOOGLE_PRIVATE_KEY=

# 직원 로그인(next-auth). 비밀값은 openssl rand -base64 32 등으로 만든 임의 문자열
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# 구글 로그인(OAuth 클라이언트). 없으면 구글 로그인 버튼이 나오지 않음
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 로그인 허용 도메인(쉼표로 여러 개). 비어 있으면 구글 로그인은 아무도 허용하지 않음
ALLOWED_EMAIL_DOMAIN=sasw.or.kr

# 마감 처리 크론 인증(16자 이상 임의 문자열). Vercel 이 Authorization 헤더로 보냄
CRON_SECRET=
# 결과 요약 메일: log(보내지 않고 로그만, 기본) 또는 resend
MAIL_PROVIDER=log
RESEND_API_KEY=
# 보내는 주소(Resend 에서 인증한 도메인). 예: 만족도 설문 <survey@sasw.or.kr>
MAIL_FROM=
# 결과 요약을 받을 담당자(쉼표로 여러 명). 설문을 만든 담당자에게도 함께 보냄
ADMIN_NOTIFY_EMAIL=
