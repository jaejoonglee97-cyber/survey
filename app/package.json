{
  "name": "sasw-survey",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "sheets:check": "tsx --env-file-if-exists=.env.local scripts/sheets-check.ts",
    "sheets:init": "tsx --env-file-if-exists=.env.local scripts/sheets-init.ts",
    "test:coverage": "vitest run --coverage",
    "seed:dummy": "tsx --env-file-if-exists=.env.local scripts/seed-dummy.ts"
  },
  "dependencies": {
    "@googleapis/sheets": "^18.1.2",
    "next": "15.5.29",
    "next-auth": "^4.24.15",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
